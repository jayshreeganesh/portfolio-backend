# Copy to .env and fill in your values.

# Server port
PORT=5000

# MongoDB connection string. If omitted, the server runs in "no-DB" mode
# and logs messages to the console instead of persisting them.
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Comma-separated list of allowed origins for CORS (frontend URLs).
# 5173 = Vite (React), 8000 = static server for the vanilla site.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
